                    <div>
                        <strong>GitHub</strong><br>
                        <a href="https://github.com/Jazblue" target="_blank">github.com/Jazblue</a>
                    </div>
                </div>

                <div class="contact-item">
                    <div class="contact-icon">
                        <i class="fas fa-file-alt"></i>
                    </div>
                    <div>
                        <strong>Download CV</strong><br>
                        <a href="jasoncvaugust2026.docx" download>Latest CV (DOCX)</a>
                    </div>
                </div>
            </div>
        </div>

<section id="contact-form">
    <h2>Send Me a Message</h2>

    <form id="contactForm">
        <input type="text" id="name" name="name" placeholder="Your Name" required />
        <input type="email" id="email" name="email" placeholder="Your Email" required />
        <textarea id="message" name="message" placeholder="Your Message" required></textarea>
        <button type="submit">Send</button>
        <div id="contactResponse"></div>
    </form>
</section>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const contactForm = document.getElementById("contactForm");
    const contactResponse = document.getElementById("contactResponse");

    contactForm.addEventListener("submit", async function(e) {
        e.preventDefault();

        const formData = new URLSearchParams();
        formData.append("name", document.getElementById("name").value);
        formData.append("email", document.getElementById("email").value);
        formData.append("message", document.getElementById("message").value);

        contactResponse.innerHTML = "Sending...";

        try {
            const response = await fetch("https://8b3275icpc.execute-api.eu-west-2.amazonaws.com/dev/", {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                body: formData
            });

            if (response.ok) {
                const text = await response.text();
                contactResponse.innerHTML = text || "Message sent successfully!";
                contactForm.reset();
            } else {
                contactResponse.innerHTML = "Submission failed. Server returned an error.";
            }
        } catch (err) {
            console.error("Contact form error:", err);
            contactResponse.innerHTML = "Something went wrong. Please check your connection and try again.";
        }
    });
});
</script>

        <div class="chatbot-container">
            <h2><i class="fas fa-robot"></i> AWS & Tech Assistant</h2>
            <p>Ask me anything about AWS services, cloud architecture, certifications, or my professional experience!</p>

            <div class="chatbot-interface">
                <div class="chatbot-header">
                    <i class="fas fa-comment-dots"></i> AI Assistant
                </div>

                <div class="chatbot-messages" id="chatbotMessages">
                    <div class="message bot">
                        <strong>Assistant:</strong> Hello! I'm Jason's AI assistant. I can help you learn about his AWS cloud engineering experience, skills, projects, and certifications. What would you like to know?
                    </div>
                </div>

                <div class="chatbot-input-area">
                    <input type="text" class="chatbot-input" id="chatbotInput" placeholder="Ask about AWS services, my experience, skills, or projects..." onkeypress="handleChatKeyPress(event)">
                    <button class="chatbot-send" onclick="sendMessage()">Send</button>
                </div>

                <div class="chatbot-info">
                    <strong>💡 Sample Questions:</strong><br>
                    • "What AWS certifications do you have?"<br>
                    • "Tell me about your cloud engineering projects"<br>
                    • "What are your strongest AWS skills?"<br>
                    • "How much experience do you have with AWS services?"<br>
                    • "What tech stack do you specialize in?"
                </div>
            </div>
        </div>
    </div>

    <script>
        // Chatbot functionality
        let conversationHistory = [];

        function sendMessage() {
            const input = document.getElementById('chatbotInput');
            const message = input.value.trim();

            if (!message) return;

            // Add user message to chat
            addMessage(message, 'user');
            conversationHistory.push({ role: 'user', content: message });

            // Clear input
            input.value = '';

            // Simulate bot response with timeout
            setTimeout(() => {
                const botResponse = generateBotResponse(message);
                addMessage(botResponse, 'bot');
                conversationHistory.push({ role: 'assistant', content: botResponse });
            }, 1000);
        }

        function handleChatKeyPress(event) {
            if (event.key === 'Enter' && !event.shiftKey) {
                event.preventDefault();
                sendMessage();
            }
        }

        function addMessage(message, sender) {
            const messagesContainer = document.getElementById('chatbotMessages');
            const messageElement = document.createElement('div');
            messageElement.className = `message ${sender}`;
            messageElement.innerHTML = `
                <strong>${sender === 'user' ? 'You' : 'Assistant'}:</strong> ${message}
            `;
            messagesContainer.appendChild(messageElement);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        function generateBotResponse(userMessage) {
            const lowerMessage = userMessage.toLowerCase();
            // Check conversation history for context
            let context = "";
            if (conversationHistory.length > 2) {
                context = "Based on our previous conversation about ";
                // Add some context from earlier messages
                const recentMessages = conversationHistory.slice(-3);
                context += recentMessages.map(msg => msg.role === 'user' ? msg.content : "my expertise").join(", ");
            }

            if (lowerMessage.includes('aws') && lowerMessage.includes('certification')) {
                return `${context} I have AWS Cloud Practitioner certification (October 2025) and AWS Cloud Quest: Cloud Practitioner (April 2025). My AWS experience includes hands-on projects with Lambda, EC2, S3, Glue, Athena, and Python automation.`;
            } else if (lowerMessage.includes('skill') || lowerMessage.includes('experience')) {
                return `${context} My key skills include AWS cloud services (Lambda, EC2, S3, Glue, Athena), Python, SQL, and IT operations (ServiceNow, incident management). I have over 10 years of customer service experience and hands-on AWS project work.`;
            } else if (lowerMessage.includes('project')) {
                return `${context} My AWS projects include a Serverless Data Querying Solution using Glue/Athena/S3, Serverless Contact Forms with Lambda/EC2, Automation workflows with API integrations, and RAG AI Agents using Google Gemini.`;
            } else if (lowerMessage.includes('work experience') || lowerMessage.includes('background')) {
                return `${context} I have diverse experience: Virtual Personal Assistant (Message Direct), Customer Advisor (Sureserve), Cash Processor (Natwest), Junior IT Helpdesk Engineer (Cantium), IT Helpdesk Analyst (Nuffield Health), and Call Centre Associate (Agilisys/Kent CC).`;
            } else if (lowerMessage.includes('contact') || lowerMessage.includes('email')) {
                return `${context} You can reach me at jason_harvey@jasoncv.click. I'm also available via LinkedIn (linkedin.com/in/jason-harvey-44574791/) and GitHub (github.com/Jazblue). My CV is available for download on this site.`;
            } else if (lowerMessage.includes('education') || lowerMessage.includes('degree')) {
                return `${context} I have various certifications including AWS Cloud Practitioner (2025), Python Essentials (Cisco 2024), Endpoint Security (Cisco 2024), and multiple cybersecurity and AI training courses from 2023-2024.`;
            } else if (lowerMessage.includes('stock') || lowerMessage.includes('market')) {
                return `${context} I can provide stock market information! Please specify which company you're interested in, and I'll give you details about their current stock performance, news, and technical analysis.`;
            } else if (lowerMessage.includes('hello') || lowerMessage.includes('hi')) {
                return `${context} Hello! Welcome to my professional portfolio. I'm Jason's AI assistant, here to help you learn about my AWS cloud engineering experience, skills, projects, and certifications. What would you like to know about me?`;
            } else {
                const responses = [
                    `${context} That's an interesting question! I can help you learn about my AWS cloud engineering expertise, technical skills, or professional background. What specific aspect would you like to know more about?`,
                    `${context} Great question! My experience spans AWS cloud architecture, infrastructure automation, customer service, and DevOps practices. I can tell you more about any of these areas or my specific projects and achievements.`,
                    `${context} I'm here to help you understand my professional background in AWS cloud engineering and IT support. I have 10+ years of customer service experience and hands-on AWS project work. What interests you most?`
                ];
                return responses[Math.floor(Math.random() * responses.length)];
            }
        }

        // Initial greeting
        setTimeout(() => {
            const greeting = "Welcome! I'm Jason's AI assistant. I can provide detailed information about his AWS cloud engineering experience, technical skills, projects, and certifications. What would you like to know about me?";
            addMessage(greeting, 'bot');
            conversationHistory.push({ role: 'assistant', content: greeting });
        }, 500);
    </script>
</body>
</html>